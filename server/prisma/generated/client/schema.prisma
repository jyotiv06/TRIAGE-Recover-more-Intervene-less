generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecoveryActionType {
  RETRY
  PAYMENT_LINK
  REMINDER
  DO_NOTHING
  ESCALATE
}

enum RecoveryCaseStatus {
  OPEN
  ACTION_PENDING
  RECOVERED
  EXHAUSTED
  STOPPED
}

model Customer {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payments      Payment[]
  recoveryCases RecoveryCase[]
  opportunities Opportunity[]
}

model Payment {
  id            String         @id @default(uuid())
  amount        Float
  currency      String         @default("INR")
  status        String // e.g., "FAILED", "SUCCESS", "PENDING"
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])
  createdAt     DateTime       @default(now())
  events        PaymentEvent[]
  recoveryCases RecoveryCase[]
  opportunity   Opportunity?
}

model PaymentEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())
}

model RecoveryCase {
  id        String @id @default(cuid())
  paymentId String

  diagnosis  String?
  confidence Float?

  naturalRecoveryProbability      Float?
  interventionRecoveryProbability Float?

  incrementalLift            Float?
  expectedIncrementalRevenue Decimal? @db.Decimal(12, 2)

  recommendedAction RecoveryActionType?
  status            RecoveryCaseStatus  @default(OPEN)

  payment   Payment          @relation(fields: [paymentId], references: [id])
  actions   RecoveryAction[]
  auditLogs AuditLog[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  @@index([paymentId])
  @@index([status])
}

model RecoveryAction {
  id             String       @id @default(uuid())
  recoveryCaseId String
  recoveryCase   RecoveryCase @relation(fields: [recoveryCaseId], references: [id])
  actionType     String // e.g., "EMAIL_SENT", "WHATSAPP_SENT", "DISCOUNT_OFFERED"
  status         String // e.g., "PENDING", "SENT", "FAILED"
  createdAt      DateTime     @default(now())
}

model AuditLog {
  id             String        @id @default(uuid())
  action         String
  details        Json?
  createdAt      DateTime      @default(now())
  recoveryCase   RecoveryCase? @relation(fields: [recoveryCaseId], references: [id])
  recoveryCaseId String?
}

model Policy {
  id        String   @id @default(uuid())
  name      String
  rules     Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opportunity {
  id         String   @id @default(uuid())
  paymentId  String   @unique
  payment    Payment  @relation(fields: [paymentId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  amount   Float
  currency String @default("INR")

  customerSegment      String // NEW | RETURNING | VIP
  previousSuccessCount Int
  previousFailureCount Int
  daysSinceLastSuccess Int?
  attemptCount         Int
  failureReason        String // INSUFFICIENT_FUNDS | BANK_DECLINE | EXPIRED_CARD | NETWORK_ERROR | OTHER
  opportunityStatus    String // FAILED | ABANDONED | ALREADY_RECOVERED | LATE_AUTH
  hoursSinceFailure    Float
  checkoutAbandoned    Boolean
  lateAuthorization    Boolean
  alreadyRecovered     Boolean

  naturalRecoveryProbability Float
  recoveredNaturally         Boolean

  aiEstimatedLift         Float?
  aiRecommendedAction     String?
  selectedForIntervention Boolean @default(false)

  diagnosis                             String?
  diagnosisConfidence                   Float?
  aiNaturalRecoveryProbability          Float?
  aiRecoveryWithInterventionProbability Float?
  diagnosedAt                           DateTime?

  incrementalLift            Float?
  expectedIncrementalRevenue Decimal? @db.Decimal(12, 2)

  selectionReason String?

  createdAt DateTime @default(now())
}
